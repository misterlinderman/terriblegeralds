# API Configuration
# Dev: use /api (Vite proxy → localhost:3001). Production: full URL e.g. https://api.example.com/api
VITE_API_URL=/api

# Auth0 Configuration
# Get these from your Auth0 Application Settings
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=http://localhost:3001/api

# Optional — home hero reel (drop file in repo assets/hero/; see assets/hero/README.md)
# VITE_HERO_VIDEO_URL=/media/hero/terrible-geralds-hero-260725-1.mp4
